# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data: regenerated by `python -m src.run_preprocess`, never committed
data/raw/*
data/interim/*
data/processed/*
data/splits/*
data/*.log
# Keep the empty folder structure visible
!data/**/.gitkeep

# Cached spectrograms / features / raw audio (anywhere in the tree)
*.npy
*.npz
*.parquet
*.wav
*.flac
*.h5
*.hdf5
logmel/
cache/
.cache/

# Model outputs / checkpoints
models/
checkpoints/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Files over 50 MB: git cannot ignore by size. Check before committing with
#   find . -path ./.git -prune -o -path ./.venv -prune -o -type f -size +50M -print
# and list any hit here explicitly.

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Page images from scripts/report_to_pdf.py --check (visual check only)
*_pages/
